{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "task_extraction.v1",
  "title": "task_extraction.v1",
  "description": "Source of truth (D2) for the task-extraction surface (strategy §4.1). Property order below is the intended generation/conditioning order (D3.3) - title first, then user-stated facts, then classification fields, recurrence last - but JSON Schema itself does not enforce key order; the .gbnf grammar is what actually fixes it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "description",
    "estimated_duration_minutes",
    "duration_from_user",
    "duration_type",
    "due",
    "context_tags",
    "tool_requirements",
    "energy",
    "importance_user",
    "recurrence"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    },
    "estimated_duration_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1440
    },
    "duration_from_user": {
      "type": "boolean"
    },
    "duration_type": {
      "enum": ["estimate", "floor"]
    },
    "due": {
      "$ref": "#/$defs/DueSpec"
    },
    "context_tags": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20
      }
    },
    "tool_requirements": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20
      }
    },
    "energy": {
      "enum": ["low", "med", "high", null]
    },
    "importance_user": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 10
    },
    "recurrence": {
      "$ref": "#/$defs/RecurrenceSpec"
    }
  },
  "$defs": {
    "Weekday": {
      "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
    },
    "Period": {
      "enum": ["day", "week", "month"]
    },
    "DueSpec": {
      "description": "null | on_date | in_days | weekday (strategy D5). Dates are transcription, not math - see src/llm/due/dueSpec.ts for how the year/weekday edges resolve.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "date"],
          "properties": {
            "kind": { "const": "on_date" },
            "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "days"],
          "properties": {
            "kind": { "const": "in_days" },
            "days": { "type": "integer", "minimum": 1, "maximum": 365 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "day", "which"],
          "properties": {
            "kind": { "const": "weekday" },
            "day": { "$ref": "#/$defs/Weekday" },
            "which": { "enum": ["this", "next"] }
          }
        }
      ]
    },
    "RecurrenceSpec": {
      "description": "null (true one-off) | scheduled_quota | quota | scheduled | unscheduled | count (strategy D6). Mirrors src/types/domain.ts's Recurrence minus `progress` (a new task starts at 0). null and {type:'unscheduled'} have opposite completion semantics and must never collapse (constraint #5, data-layer brief).",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "quota", "period", "days"],
          "properties": {
            "type": { "const": "scheduled_quota" },
            "quota": { "type": "integer", "minimum": 1 },
            "period": { "$ref": "#/$defs/Period" },
            "days": {
              "type": "array",
              "minItems": 1,
              "maxItems": 7,
              "items": { "$ref": "#/$defs/Weekday" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "quota", "period"],
          "properties": {
            "type": { "const": "quota" },
            "quota": { "type": "integer", "minimum": 1 },
            "period": { "$ref": "#/$defs/Period" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "days"],
          "properties": {
            "type": { "const": "scheduled" },
            "days": {
              "type": "array",
              "minItems": 1,
              "maxItems": 7,
              "items": { "$ref": "#/$defs/Weekday" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "unscheduled" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target"],
          "properties": {
            "type": { "const": "count" },
            "target": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    }
  }
}
